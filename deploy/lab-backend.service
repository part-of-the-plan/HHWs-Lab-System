# ═══════════════════════════════════════════════════════════════
# systemd 服务单元：用 Gunicorn 托管 Flask 后端，开机自启、崩溃自拉
#
# 部署（Ubuntu）：
#   sudo cp deploy/lab-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable lab-backend     # 开机自启
#   sudo systemctl start  lab-backend
#   sudo systemctl status lab-backend     # 看状态
#   journalctl -u lab-backend -f          # 看实时日志
#
# ⚠️ 下面三处按你的服务器实际路径改：
#   User / WorkingDirectory / ExecStart 里的 venv 路径
#   假设代码放在 /opt/lab/project，部署用户叫 labuser
# ═══════════════════════════════════════════════════════════════
[Unit]
Description=Lab Device Management Backend (Gunicorn)
After=network.target

[Service]
Type=notify
User=labuser
Group=labuser

# 后端代码目录（wsgi.py 与 gunicorn.conf.py 所在处）
WorkingDirectory=/opt/lab/project/backend

# 关键：生产环境标志，create_app() 据此选 ProductionConfig
Environment=FLASK_ENV=production

# .env 文件由 config.py 的 load_dotenv() 自动加载，这里无需重复

# 用 venv 里的 gunicorn 启动；配置全在 gunicorn.conf.py
ExecStart=/opt/lab/project/backend/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app

# 平滑重载（改代码后 sudo systemctl reload lab-backend）
ExecReload=/bin/kill -s HUP $MAINPID

Restart=always
RestartSec=5

# ---- 基础安全加固 ----
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
