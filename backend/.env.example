# ===== Flask =====
FLASK_ENV=development
SECRET_KEY=change-me-dev-secret

# ===== 数据库（对应 docker-compose.dev.yml）=====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lab_device_db
DB_USER=lab_user
DB_PASSWORD=lab_pass123

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== JWT =====
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRE_HOURS=2

# ===== 国密 / 加密开关 =====
# CRYPTO_BACKEND: gmssl(主，国密SM3/SM4) | openssl(兜底，hashlib/cryptography)
# gmssl 卡住时改成 openssl 先跑通业务，回头再修国密
CRYPTO_BACKEND=gmssl
# SM4 密钥：16字节(32位hex)。上云务必更换
SM4_KEY=0123456789abcdeffedcba9876543210

# ===== 业务规则（配置与代码分离，改这里不动逻辑）=====
MAX_BORROW_COUNT=3          # 单用户同时最多借几台
MAX_BORROW_DAYS=30          # 最长借用天数
LOGIN_FAIL_LIMIT=5          # 连续失败几次锁定
LOGIN_LOCK_MINUTES=10       # 锁定时长(分钟)
CAPTCHA_EXPIRE_SECONDS=60   # 验证码有效期

# ===== 初始超管账号（系统首次启动时写死创建）=====
INIT_SUPERADMIN_USERNAME=superadmin
INIT_SUPERADMIN_PASSWORD=Admin@123456
