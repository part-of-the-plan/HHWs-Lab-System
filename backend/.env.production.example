# ═══════════════════════════════════════════════════════════════
# 生产环境变量模板 —— 部署到云服务器时复制成 backend/.env 并改值
#   cp backend/.env.production.example backend/.env
#   然后逐项把【改我】替换成真实值
#
# ⚠️ .env 已在 .gitignore，绝不提交到 git
# ⚠️ 所有密钥/密码必须换成强随机值，不要沿用开发默认值
# ═══════════════════════════════════════════════════════════════

# ===== Flask =====
# 关键：必须是 production，create_app() 据此关 debug、开 ProxyFix、收紧 CORS
FLASK_ENV=production
# 强随机串：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=【改我-强随机32字节hex】

# ===== 数据库（云服务器本机 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lab_device_db
DB_USER=lab_user
DB_PASSWORD=【改我-数据库强密码】

# ===== Redis =====
# Redis 无密码（仅本机监听，不暴露公网，安全）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ===== JWT =====
# 另一个独立强随机串，别和 SECRET_KEY 相同
JWT_SECRET_KEY=【改我-另一个独立随机串，别和 SECRET_KEY 一样】
JWT_EXPIRE_HOURS=2

# ===== 国密 / 加密开关 =====
CRYPTO_BACKEND=gmssl
# SM4 密钥 16字节(32位hex)，生产务必更换：python -c "import secrets;print(secrets.token_hex(16))"
SM4_KEY=【改我-32位hex】

# ===== CORS 白名单（生产可留空：同域部署无跨域）=====
CORS_ORIGINS=

# ===== 业务规则 =====
MAX_BORROW_COUNT=3
MAX_BORROW_DAYS=30
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=10
CAPTCHA_EXPIRE_SECONDS=60

# ===== 初始超管账号（首次 flask init-db 时创建）=====
INIT_SUPERADMIN_USERNAME=superadmin
INIT_SUPERADMIN_PASSWORD=【改我-超管强密码】
